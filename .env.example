# Variables para `docker compose up` (copiar a .env). Los valores de WhatsApp y
# OpenAI solo hacen falta para probar el bot de punta a punta.

# Opcional: contraseña del Postgres local (por defecto "dispatch").
POSTGRES_PASSWORD=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OPENAI_API_KEY=

# Compartido entre bot y portal.
INTERNAL_SECRET=

# Apagado por defecto: con false el bot no envía mensajes de WhatsApp.
BOT_ACTIVE=false

# Marca del cliente en el portal (se incrusta al construir la imagen).
NEXT_PUBLIC_CLIENT_NAME=
NEXT_PUBLIC_CLIENT_INITIALS=
NEXT_PUBLIC_CLIENT_COLOR=

# Solo para correr scripts de la raíz fuera de Docker (db:migrate,
# db:seed:demo, db:studio): ponlos en .env.local.
# DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch
