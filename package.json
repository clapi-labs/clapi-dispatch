{
  "name": "clapi-dispatch",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=@dispatch/bot",
    "dev:portal": "npm run dev --workspace=@dispatch/portal",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --build --verbose",
    "db:studio": "npm run db:studio --workspace=@dispatch/shared",
    "db:generate": "npm run db:generate --workspace=@dispatch/shared",
    "db:migrate": "npm run db:migrate --workspace=@dispatch/shared",
    "db:seed:demo": "npm run db:seed:demo --workspace=@dispatch/shared"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
