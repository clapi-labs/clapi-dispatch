DATABASE_URL=

# Firma de la cookie de sesión: mínimo 32 caracteres aleatorios
# (openssl rand -base64 48). Cambiarla cierra todas las sesiones.
SESSION_SECRET=

# El mismo valor que tiene el bot: con él el portal le pide enviar WhatsApp.
INTERNAL_SECRET=
# URL del bot, sin "/" al final. En local: http://localhost:3001
BOT_URL=

# Opcionales: marca del cliente en el portal.
NEXT_PUBLIC_CLIENT_NAME=
NEXT_PUBLIC_CLIENT_INITIALS=
NEXT_PUBLIC_CLIENT_COLOR=
