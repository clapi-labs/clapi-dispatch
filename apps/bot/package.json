{
  "name": "@dispatch/bot",
  "version": "0.1.0",
  "private": true,
  "description": "Webhook de WhatsApp: extrae el viaje del mensaje libre y lo entrega a despacho",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "chat": "tsx --env-file-if-exists=../../.env.local scripts/chat.ts",
    "restaurant:create": "tsx --env-file-if-exists=../../.env.local scripts/restaurant-create.ts",
    "mensajes": "tsx --env-file-if-exists=../../.env.local scripts/messages-report.ts",
    "gps:sim": "tsx --env-file-if-exists=../../.env.local scripts/gps-sim.ts",
    "eval:restaurantes": "tsx --env-file-if-exists=../../.env.local scripts/restaurant-match-eval.ts",
    "direcciones:medir": "tsx --env-file-if-exists=../../.env.local scripts/address-bench.ts",
    "direcciones:referencia": "tsx scripts/address-bench.ts --referencia"
  },
  "dependencies": {
    "@dispatch/shared": "*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6"
  }
}
