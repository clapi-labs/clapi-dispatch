# Variables del servidor. Se copia a /opt/dispatch/.env (dueño deploy, grupo
# docker, permisos 660: lo leen deploy y los administradores) y se llena a mano.
# Este archivo NUNCA lleva valores reales.

# --- Dominios y registro ---
PORTAL_HOST=staging.dispatch.clapi.solutions
BOT_HOST=bot.staging.dispatch.clapi.solutions
ACME_EMAIL=
# Prefijo de las imágenes en GHCR (en minúsculas).
REGISTRY=ghcr.io/clapi-labs
# Solo si los paquetes de GHCR son privados: usuario y token con permiso read:packages.
GHCR_USER=
GHCR_TOKEN=

# --- Generar con: openssl rand -base64 36 ---
POSTGRES_PASSWORD=
INTERNAL_SECRET=
# Mínimo 32 caracteres. Cambiarla cierra todas las sesiones del portal.
SESSION_SECRET=

# --- WhatsApp (Meta) y OpenAI: pueden quedar vacíos hasta tenerlos ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Texto inventado por nosotros; el mismo que se pone en el panel de Meta.
WHATSAPP_VERIFY_TOKEN=
OPENAI_API_KEY=
# Llave restringida a la Geocoding API, con tope diario. Vacía = viajes sin coordenadas.
GOOGLE_MAPS_API_KEY=
# false = el bot no envía mensajes. Pasar a true solo cuando se quiera.
BOT_ACTIVE=false
